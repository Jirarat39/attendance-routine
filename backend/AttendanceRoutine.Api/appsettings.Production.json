{
  "ConnectionStrings": {
    "AttendanceDb": ""
  },
  "DatabaseMapping": {
    "AttendanceTable": "dbo.Attendances",
    "EmployeeTable": "dbo.Employees",
    "AttendanceIdColumn": "",
    "AttendanceEmployeeKeyColumn": "",
    "CheckInColumn": "",
    "CheckOutColumn": "",
    "EmployeeKeyColumn": "",
    "EmployeeCodeColumn": "",
    "EmployeeNameColumn": "",
    "DepartmentColumn": ""
  },
  "Reports": {
    "Enabled": true,
